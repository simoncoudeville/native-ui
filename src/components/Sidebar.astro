---
import { getCollection } from 'astro:content';

interface Props {
  /** Headings of the current page, so the active entry can expand in place. */
  headings?: { depth: number; slug: string; text: string }[];
}

const { headings = [] } = Astro.props;

const elements = (await getCollection('elements', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const path = Astro.url.pathname;
const isHome = path === '/';

/*
  Only h2s go in the nav. Deeper headings exist inside the demos' prose and
  would turn a 4-item list into a 20-item one, which is exactly the wall of
  links a sidebar is supposed to prevent.
*/
const sections = headings.filter((heading) => heading.depth === 2);
---

<nav class="sidebar" aria-label="Site">
  <a class="brand" href="/">
    <svg class="brand-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <rect x="0.75" y="0.75" width="14.5" height="14.5" rx="3.5" />
      <rect x="4.25" y="4.25" width="7.5" height="7.5" rx="1.75" class="brand-mark-inner" />
    </svg>
    <span class="brand-text">
      Native UI
      <small>interactive elements the platform ships</small>
    </span>
  </a>

  <div class="nav-group">
    <p class="nav-label" id="nav-overview">Overview</p>
    <ul class="nav-list" aria-labelledby="nav-overview">
      <li>
        <a href="/" aria-current={isHome ? 'page' : undefined}>Introduction</a>
      </li>
    </ul>
  </div>

  <div class="nav-group">
    <p class="nav-label" id="nav-elements">Elements</p>
    <ul class="nav-list" aria-labelledby="nav-elements">
      {
        elements.map((entry) => {
          const href = `/elements/${entry.id}/`;
          const current = path === href;
          return (
            <li>
              <a href={href} class="mono" aria-current={current ? 'page' : undefined}>
                {entry.data.elementName}
              </a>
              {current && sections.length > 0 && (
                <ul class="nav-sections">
                  {sections.map((section) => (
                    <li>
                      <a href={`#${section.slug}`}>{section.text}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="nav-group">
    <p class="nav-label" id="nav-data">Data</p>
    <ul class="nav-list" aria-labelledby="nav-data">
      <li>
        <a href="https://web-platform-dx.github.io/web-features/">Baseline</a>
      </li>
      <li>
        <a href="https://github.com/web-platform-dx/web-features">web-features</a>
      </li>
      <li>
        <a href="https://github.com/mdn/browser-compat-data">browser-compat-data</a>
      </li>
    </ul>
  </div>
</nav>
